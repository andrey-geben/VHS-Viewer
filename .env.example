# ==== VHS-Viewer: общие секреты ====

# Открытие реле (эндпоинт /api/relay/<id>/open)
# Длинная случайная строка. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SECRET=

# Bot-facing конфиг (эндпоинт /api/bots/<id>/config)
# Второй, отдельный секрет. Принцип наименьших привилегий:
# утечка одного не даёт доступа к другому.
BOT_CONFIG_SECRET=

# ==== Только для локальной разработки одного бота ====
# Когда запускаете один бот — укажите его id здесь.
# Когда ботов несколько — заведите .env.local в папке бота
# или задайте BOT_ID в systemd Environment=.
BOT_ID=

# ==== Куда ходить боту за конфигом ====
VIEWER_API=http://127.0.0.1:8200

# ==== Что БОЛЬШЕ НЕ ХРАНИТСЯ в .env ====
# VK_BOT_TOKEN, TG_BOT_TOKEN, MAX_BOT_TOKEN, *_ALLOWED_IDS, RELAY_ID
# — всё это теперь в viewer_config.yaml через UI /bots